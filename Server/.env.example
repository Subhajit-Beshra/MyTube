PORT=5000
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
DB_URL=mongodb://127.0.0.1:27017/mytube
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=add_your_google_oauth_client_id

# Email verification uses the Resend API. Verify the sender domain with Resend.
RESEND_API_KEY=re_replace_me
EMAIL_FROM="MyTube <noreply@example.com>"

# Google Cloud Translation API v2. Keep this key server-side.
GOOGLE_TRANSLATE_API_KEY=replace_with_google_translate_api_key

# Razorpay TEST MODE only. The API rejects non-test key IDs.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Prices are in paise; download limits are successful/reserved downloads per IST day.
FREE_DOWNLOAD_LIMIT=1
BRONZE_PRICE_PAISE=9900
BRONZE_DOWNLOAD_LIMIT=5
SILVER_PRICE_PAISE=19900
SILVER_DOWNLOAD_LIMIT=20
GOLD_PRICE_PAISE=39900
GOLD_DOWNLOAD_LIMIT=100

# Server-side credentials for LiveKit video meetings. Keep the API secret private.
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
# Browser WebSocket endpoint. The matching HTTPS API URL is inferred by default.
LIVEKIT_URL=wss://your-livekit-host
# Optional management API override; must use http:// or https://, not ws:// or wss://.
# LIVEKIT_API_URL=https://your-livekit-host
